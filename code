
import gradio as gr
from google import genai
from dotenv import load_dotenv
import os
import requests
import json
from bs4 import BeautifulSoup
from google.genai import types

load_dotenv()
gemini_key = os.environ.get("GEMINI_API_KEY")
serper_key = os.environ.get("SERPER_API_KEY")

client = genai.Client(api_key=gemini_key)
default_model = "gemini-3.8-flash"

def get_player_details(player_name):

    QUERY = f'site:www-old.cev.eu/Competition-Area/PlayerDetails.aspx {player_name}'
    search_url = "https://google.serper.dev/search"
    payload = json.dumps({"q": QUERY })
    headers = {
        'X-API-KEY': serper_key,
        'Content-Type': 'application/json'
    }

    response = requests.post(search_url, headers=headers, data=payload)
    data = response.json()

    try:
        top_results = data.get("organic", [])[:3]
        if not top_results:
            return f"Could not find any player named '{player_name}'."
    except Exception as e:
        return "An error occurred during the search. Please try again."

    search_context = ""
    for i, res in enumerate(top_results):
        search_context += f"Result {i+1}:\nTitle: {res.get('title')}\nLink: {res.get('link')}\nSnippet: {res.get('snippet')}\n\n"

    url_prompt = f"""You are an assistant routing search results. The user searched for the volleyball player "{player_name}".
Here are the top search results:

{search_context}

Rules:
1. If the results clearly point to ONE specific player that the user most likely intended, return this JSON: {{"status": "clear", "url": "the_url_here"}}
2. If the search is ambiguous because the results show multiple DIFFERENT players (for example, different first names with the searched surname), return this JSON: {{"status": "ambiguous", "options": ["Name 1", "Name 2", "Name 3"]}}

Return ONLY valid JSON and do not include any other text."""

    url_response = client.models.generate_content(
        model=default_model,
        contents=url_prompt,
        config=types.GenerateContentConfig(
            response_mime_type="application/json",
        )
    )

    url_data = json.loads(url_response.text)

    if url_data.get("status") == "ambiguous":
        options_list = url_data.get("options", [])
        if options_list:
            options_str = ", ".join(options_list)
            return f"The search returned multiple matches. Did you mean one of these: {options_str}?"
        else:
            return "The search was too ambiguous. Please provide the player's full name."
    
    elif url_data.get("status") == "clear" and url_data.get("url"):
        link = url_data.get("url")
    else:
        return f"Could not determine the correct player profile for '{player_name}'."
    
    page_response = requests.get(link)
    soup = BeautifulSoup(page_response.text, 'html.parser')
    clean_text = soup.get_text(separator=' ', strip=True)

    prompt = f"""Analyze the following text data regarding the volleyball player '{player_name}'.
Return the result as a valid JSON object. It must ONLY contain the following keys and no surrounding explanation or markdown:
- full_name (str, the player's full and correctly spelled name)
- country (str, nationality or the country the player represents)
- clubs (list of strings, all clubs the player has played for mentioned in the data)
- competitions (list of strings, all tournaments or leagues the player has participated in mentioned in the data)

If any detail is missing from the text data, set its value to null or an empty list ([]). Do not guess or hallucinate any information.

Data to analyze:
{clean_text}"""
    
    gemini_response = client.models.generate_content(
        model=default_model,
        contents=prompt,
        config=types.GenerateContentConfig(
            response_mime_type="application/json",
        )
    )

    player_data_json = json.loads(gemini_response.text)

    with open("player_database.json", "a", encoding="utf-8") as file:
        json.dump(player_data_json, file, indent=4, ensure_ascii=False)
        file.write("\n")
    
    return player_data_json.get("full_name", player_name)